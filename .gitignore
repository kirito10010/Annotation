# ---- Python 字节码缓存 ----
__pycache__/
*.py[cod]

# ---- PyInstaller 打包中间产物（每次打包都全量变化，不进仓库）----
build/

# ---- 打包产物：exe 走 GitHub Release 分发，不进仓库（否则每次重打包都多一份 ~19MB 二进制）----
dist/

# ---- 程序运行时产生的更新器临时文件 ----
*.exe.new
*.exe.new.part*
*.update.bat
*.updated
*.old

# ---- 发布清单只作为 GitHub Release 资产分发，不进仓库（本地保留用于打包/上传）----
version.json

# ---- Comate 规格/工作区文件（本地保留，不进仓库）----
.comate/

# ---- 含全员真实账号密码，禁止推送 ----
账号.md

# ---- 含内网地址与平台接口细节，禁止推送 ----
LabelAuto数据查询操作文档.md

